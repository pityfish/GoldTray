{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "GoldTray 主窗口与悬浮行情条默认权限",
  "windows": ["main", "hud"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "notification:default",
    "autostart:default",
    "opener:default",
    "opener:allow-open-url"
  ]
}
